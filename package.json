{
  "name": "credential-calendar-maker",
  "version": "1.0.0",
  "description": "Turn a credential-expiry CSV into a portable renewal calendar.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/run-playwright.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "deps:audit": "npm audit --audit-level=high",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "license:check": "node scripts/license-check.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run deps:audit && npm run secrets:scan && npm run license:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
